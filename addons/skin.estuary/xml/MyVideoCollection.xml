<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>504,50,51,52,53,54,55,500,501,502</views>
	<menucontrol>9000</menucontrol>
	<controls>
		<include>DefaultBackground</include>
		<control type="group">
			<visible>Control.IsVisible(54) + !String.IsEmpty(Window.Property(CollectionName))</visible>
			<control type="image">
				<left>-40</left>
				<top>-10%</top>
				<width>656</width>
				<height>120%</height>
				<texture colordiffuse="EDFFFFFF">lists/panel.png</texture>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<bordersize>20</bordersize>
			</control>
			<control type="image">
				<left>148</left>
				<top>110</top>
				<width>320</width>
				<height>470</height>
				<texture background="true" fallback="DefaultVideo.png">$INFO[Window.Property(CollectionPoster)]</texture>
				<aspectratio>scale</aspectratio>
				<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
				<bordersize>20</bordersize>
			</control>
			<control type="textbox">
				<left>30</left>
				<top>590</top>
				<width>550</width>
				<height>110</height>
				<aligny>center</aligny>
				<font>font36_title</font>
				<label>$INFO[Window.Property(CollectionName)]</label>
			</control>
			<control type="textbox">
				<left>30</left>
				<top>710</top>
				<width>550</width>
				<bottom>60</bottom>
				<label>$INFO[Window.Property(CollectionDescription)]</label>
				<autoscroll delay="3000" time="1000" repeat="9000">Control.HasFocus(54)</autoscroll>
			</control>
		</control>
		<control type="group">
			<include>View_50_List</include>
			<include>View_51_Poster</include>
			<include>View_52_IconWall</include>
			<include>View_53_Shift</include>
			<include>View_54_InfoWall</include>
			<include>View_55_WideList</include>
			<include>View_500_Wall</include>
			<include>View_501_Banner</include>
			<include>View_502_FanArt</include>
			<include>View_504_MediaList</include>
			<include>CommonScrollbars</include>
			<include content="TopBar">
				<param name="breadcrumbs_label" value="$VAR[BreadcrumbsCollectionVar]" />
			</include>
			<include content="BottomBar">
				<param name="info_visible" value="true" />
			</include>
			<include>MediaMenuMouseOverlay</include>
			<control type="group">
				<include>MediaMenuCommon</include>
				<control type="grouplist" id="9000">
					<top>50</top>
					<include>MediaMenuListCommon</include>
					<control type="button" id="10">
						<description>Watched Toggle</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[20367]</label>
						<label2>[B]$INFO[Container.NumItems][/B]</label2>
						<visible>Container.Content(mixed)</visible>
					</control>
					<control type="label" id="203">
						<include>MediaMenuLabelCommon</include>
						<label>$LOCALIZE[31020]</label>
					</control>
					<control type="togglebutton" id="619">
						<description>Update library</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[653]</label>
						<onclick>UpdateLibrary(video)</onclick>
						<altlabel>$LOCALIZE[13353]</altlabel>
						<usealttexture>library.isscanningvideo</usealttexture>
					</control>
					<control type="button" id="612">
						<description>Go to playlist</description>
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[31056]</label>
						<onclick>ActivateWindow(videoplaylist)</onclick>
						<visible>Integer.IsGreater(Playlist.Length(video),0)</visible>
					</control>
					<include>MediaMenuNowPlaying</include>
				</control>
			</control>
		</control>
	</controls>
</window>
